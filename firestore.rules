rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'nhan1545a@gmail.com';
    }
    
    // User profiles
    match /users/{userId} {
      // Allow read for authenticated users and admin can read all
      allow read: if request.auth != null;
      
      // Allow write only for the owner or admin
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }
    
    // User conversations
    match /users/{userId}/conversations/{conversationId} {
      // Allow read/write for the owner or admin can read all
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }
    
    // Global conversations (if needed)
    match /conversations/{conversationId} {
      // Allow read for authenticated users
      allow read: if request.auth != null;
      
      // Allow write only for the owner or admin
      allow write: if request.auth != null && (request.auth.uid == request.resource.data.userId || isAdmin());
    }
    
    // Knowledge sources (admin only)
    match /knowledge/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    
    // Admin statistics and analytics
    match /analytics/{docId} {
      allow read, write: if isAdmin();
    }
  }
}
