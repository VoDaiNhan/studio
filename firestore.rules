/**
 * @fileoverview Firestore Security Rules for the traffic law chatbot application.
 *
 * Core Philosophy:
 * This ruleset provides public read access to all collections while restricting write access.
 * This configuration is suitable for rapid prototyping, but it is essential to implement more fine-grained authorization
 * in a production environment to protect data integrity and prevent abuse.
 *
 * Data Structure:
 * The Firestore database consists of several top-level collections:
 * - /conversations/{conversationId}: Stores chat history between users and the bot.
 * - /trafficLaws/{trafficLawId}: Stores traffic law data.
 * - /userQueries/{userQueryId}: Stores user queries.
 * - /lawBotResponses/{lawBotResponseId}: Stores chatbot responses.
 * - /feedbacks/{feedbackId}: Stores user feedback.
 *
 * Key Security Decisions:
 * - Public Read Access: All `get` and `list` operations are allowed for all users, including unauthenticated users.
 * - No Write Access: All `create`, `update`, and `delete` operations are denied.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to the 'conversations' collection.
     * @path /conversations/{conversationId}
     * @allow (get, list): Any user can read the conversation.
     * @deny (create, update, delete): No user can create, update, or delete a conversation.
     * @principle Public read, no writes.
     */
    match /conversations/{conversationId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Controls access to the 'trafficLaws' collection.
     * @path /trafficLaws/{trafficLawId}
     * @allow (get, list): Any user can read the traffic law.
     * @deny (create, update, delete): No user can create, update, or delete a traffic law.
     * @principle Public read, no writes.
     */
    match /trafficLaws/{trafficLawId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Controls access to the 'userQueries' collection.
     * @path /userQueries/{userQueryId}
     * @allow (get, list): Any user can read the user query.
     * @deny (create, update, delete): No user can create, update, or delete a user query.
     * @principle Public read, no writes.
     */
    match /userQueries/{userQueryId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Controls access to the 'lawBotResponses' collection.
     * @path /lawBotResponses/{lawBotResponseId}
     * @allow (get, list): Any user can read the law bot response.
     * @deny (create, update, delete): No user can create, update, or delete a law bot response.
     * @principle Public read, no writes.
     */
    match /lawBotResponses/{lawBotResponseId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Controls access to the 'feedbacks' collection.
     * @path /feedbacks/{feedbackId}
     * @allow (get, list): Any user can read the feedback.
     * @deny (create, update, delete): No user can create, update, or delete a feedback.
     * @principle Public read, no writes.
     */
    match /feedbacks/{feedbackId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }
  }
}