/**
 * @fileoverview Firestore Security Rules for the traffic law chatbot application.
 *
 * Core Philosophy:
 * This ruleset prioritizes data accessibility for public consumption.
 * All data except the conversation history is publicly readable, and write operations are disallowed except for the conversation history, which is anonymously writeable.
 *
 * Data Structure:
 * - /conversations/{conversationId}: Stores chat history (user queries, bot responses, etc.).  Anonymously writeable.
 * - /trafficLaws/{trafficLawId}: Stores traffic law data. Publicly readable.
 * - /userQueries/{userQueryId}: Stores user queries. Publicly readable.
 * - /lawBotResponses/{lawBotResponseId}: Stores chatbot responses. Publicly readable.
 * - /feedbacks/{feedbackId}: Stores user feedback. Publicly readable.
 *
 * Key Security Decisions:
 * - User listing is generally disallowed for privacy.
 * - Anonymous users can create conversation histories.
 * - All other collections are publicly readable to facilitate open access to traffic law information.
 * - No validation is done on data shapes.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Manages access to the conversation history. Allows anonymous users to create new conversations.
     * @path /conversations/{conversationId}
     * @allow (create) User is anonymous.
     * @deny (read, update, delete) No read, update, or delete access for any users.
     * @principle Allows anonymous users to create conversations but restricts other operations.
     */
    match /conversations/{conversationId} {
      allow get: if false;
      allow list: if false;
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allows public read access to traffic laws.
     * @path /trafficLaws/{trafficLawId}
     * @allow (get, list) Any user can read traffic laws.
     * @deny (create, update, delete) No write access for any users.
     * @principle Allows public read access to traffic laws.
     */
    match /trafficLaws/{trafficLawId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allows public read access to user queries.
     * @path /userQueries/{userQueryId}
     * @allow (get, list) Any user can read user queries.
     * @deny (create, update, delete) No write access for any users.
     * @principle Allows public read access to user queries.
     */
    match /userQueries/{userQueryId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allows public read access to law bot responses.
     * @path /lawBotResponses/{lawBotResponseId}
     * @allow (get, list) Any user can read law bot responses.
     * @deny (create, update, delete) No write access for any users.
     * @principle Allows public read access to law bot responses.
     */
    match /lawBotResponses/{lawBotResponseId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allows public read access to user feedback.
     * @path /feedbacks/{feedbackId}
     * @allow (get, list) Any user can read user feedback.
     * @deny (create, update, delete) No write access for any users.
     * @principle Allows public read access to user feedback.
     */
    match /feedbacks/{feedbackId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }

  // Helper function to determine if the user is signed in (anonymous or not)
  function isSignedIn() {
    return request.auth != null;
  }
}