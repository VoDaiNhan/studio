/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a user-ownership model for conversations, allowing users to only read and write their own conversations.
 * All other data (traffic laws, user queries, bot responses, and feedback) is publicly readable.
 *
 * Data Structure:
 * - /conversations/{conversationId}: Stores individual conversation entries, secured by user ID.
 * - /trafficLaws/{trafficLawId}: Stores traffic law data; publicly readable.
 * - /userQueries/{userQueryId}: Stores user queries; publicly readable.
 * - /lawBotResponses/{lawBotResponseId}: Stores bot responses; publicly readable.
 * - /feedbacks/{feedbackId}: Stores user feedback; publicly readable.
 *
 * Key Security Decisions:
 * - Conversations are strictly user-owned; listing, creating, updating, and deleting are restricted to the owner.
 * - All other data is publicly readable.
 * - No schema validation is performed beyond authorization checks during this prototyping phase.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to conversation documents.  Users can only manage their own conversations.
     * @path /conversations/{conversationId}
     * @allow (create) User with UID 'user123' can create a conversation document where conversation.userId == 'user123'.
     * @allow (get) User with UID 'user123' can retrieve a conversation document where conversation.userId == 'user123'.
     * @allow (list) User with UID 'user123' can list conversation documents.
     * @allow (update) User with UID 'user123' can update a conversation document where conversation.userId == 'user123'.
     * @allow (delete) User with UID 'user123' can delete a conversation document where conversation.userId == 'user123'.
     * @deny (create) User with UID 'user456' cannot create a conversation document where conversation.userId == 'user123'.
     * @deny (get) User with UID 'user456' cannot retrieve a conversation document where conversation.userId == 'user123'.
     * @deny (update) User with UID 'user456' cannot update a conversation document where conversation.userId == 'user123'.
     * @deny (delete) User with UID 'user456' cannot delete a conversation document where conversation.userId == 'user123'.
     * @principle Enforces document ownership for all operations on conversation documents.
     */
    match /conversations/{conversationId} {
      allow get: if isSignedIn() && isOwner(resource.data.userId);
      allow list: if isSignedIn() && isOwner(request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && isExistingOwner(resource.data.userId);
      allow delete: if isSignedIn() && isExistingOwner(resource.data.userId);
    }

    /**
     * @description Allows public read access to traffic law documents.
     * @path /trafficLaws/{trafficLawId}
     * @allow (get) Any user can retrieve a traffic law document.
     * @allow (list) Any user can list traffic law documents.
     * @deny (create) No one can create a traffic law document through client.
     * @deny (update) No one can update a traffic law document through client.
     * @deny (delete) No one can delete a traffic law document through client.
     * @principle Provides public read access to traffic laws.
     */
    match /trafficLaws/{trafficLawId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows public read access to user query documents.
     * @path /userQueries/{userQueryId}
     * @allow (get) Any user can retrieve a user query document.
     * @allow (list) Any user can list user query documents.
     * @deny (create) No one can create a user query document through client.
     * @deny (update) No one can update a user query document through client.
     * @deny (delete) No one can delete a user query document through client.
     * @principle Provides public read access to user queries.
     */
    match /userQueries/{userQueryId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows public read access to law bot response documents.
     * @path /lawBotResponses/{lawBotResponseId}
     * @allow (get) Any user can retrieve a law bot response document.
     * @allow (list) Any user can list law bot response documents.
     * @deny (create) No one can create a law bot response document through client.
     * @deny (update) No one can update a law bot response document through client.
     * @deny (delete) No one can delete a law bot response document through client.
     * @principle Provides public read access to law bot responses.
     */
    match /lawBotResponses/{lawBotResponseId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows public read access to feedback documents.
     * @path /feedbacks/{feedbackId}
     * @allow (get) Any user can retrieve a feedback document.
     * @allow (list) Any user can list feedback documents.
     * @deny (create) No one can create a feedback document through client.
     * @deny (update) No one can update a feedback document through client.
     * @deny (delete) No one can delete a feedback document through client.
     * @principle Provides public read access to user feedback.
     */
    match /feedbacks/{feedbackId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }
  }

  // Helper Functions
  function isSignedIn() {
    return request.auth != null;
  }

  function isOwner(userId) {
    return request.auth.uid == userId;
  }

  function isExistingOwner(userId) {
    return isOwner(userId) && resource != null;
  }
}